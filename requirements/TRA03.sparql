
# TRA03: ¿Qué incidencias están activas en un intervalo temporal?

PREFIX edinttraf: <https://edint.es/def/trafico#>
PREFIX schema: <http://schema.org/>

SELECT ?incidence ?start ?end
WHERE {
  ?incidence a edinttraf:Incidence ;
             schema:startDate ?start ;
             schema:endDate ?end .
  
  FILTER (?start <= "FECHA-INICIO-INTERVALO" && ?end >= "FECHA-FIN-INTERVALO")
}
